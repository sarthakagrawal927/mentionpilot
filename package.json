{
  "name": "mentionpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "next": "^15.1.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @mentionpilot/web dev",
    "dev:api": "pnpm --filter @mentionpilot/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "prepare": "husky"
  }
}
